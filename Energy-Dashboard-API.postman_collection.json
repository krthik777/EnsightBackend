								{
									"key": "startDate",
									"value": "2025-10-19T00:00:00Z",
									"description": "Optional: Start date",
									"disabled": true
								},
								{
									"key": "endDate",
									"value": "2025-10-22T23:59:59Z",
									"description": "Optional: End date",
									"disabled": true
								},
								{
									"key": "limit",
									"value": "50",
									"description": "Records per page (default: 100)"
								},
								{
									"key": "page",
									"value": "1",
									"description": "Page number (default: 1)"
