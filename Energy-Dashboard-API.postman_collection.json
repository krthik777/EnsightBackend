								"key": "x-user-id",
								"value": "{{user_id}}",
								"type": "text"
							},
							{
								"key": "x-room-id",
								"value": "{{room_id}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"current_rms_a\": 2.3,\n  \"apparent_power_va\": 529\n}"
